{$DOMAIN:localhost} {

    # ── WebSocket proxy ────────────────────────────────────────────────────────
    # Must be before the /api/* block. Uses HTTP/1.1 for Upgrade header (Pitfall 1 prevention).
    # Caddy handles Upgrade and Connection headers automatically, but explicit http version
    # ensures compatibility with all upstream configurations.
    handle /ws* {
        reverse_proxy api:3000 {
            transport http {
                versions 1.1
            }
        }
    }

    # ── File API — explicit body size limit for uploads (D-18 revision) ──────
    # Must be before /api/* block. Enforces 25MB Caddy-layer limit (defense-in-depth).
    handle /api/files* {
        request_body {
            max_size 25MB
        }
        uri strip_prefix /api
        reverse_proxy api:3000
    }

    # ── API proxy ─────────────────────────────────────────────────────────────
    # Strip /api prefix before forwarding to backend (backend routes are at / not /api/)
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:3000
    }

    # ── Frontend SPA (React + Vite) ───────────────────────────────────────────
    #
    # Cache strategy:
    #   - /assets/*  → content-hashed filenames (Vite rollup) — safe to cache
    #     forever with `immutable`. New deploys produce new filenames so there
    #     is no cache collision.
    #   - index.html → MUST be revalidated on every visit, otherwise users
    #     keep loading an HTML that references old JS bundles (the actual
    #     bug that broke real-time messaging after the last deploy).
    #   - everything else → standard short cache.
    handle /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        root * /srv/www
        file_server
    }

    handle {
        header Cache-Control "no-store, must-revalidate"
        root * /srv/www
        try_files {path} /index.html
        file_server
    }

    # ── Logging ───────────────────────────────────────────────────────────────
    log {
        output stdout
        format console
    }
}

{$DOMAIN:localhost} {

    # ── WebSocket proxy ────────────────────────────────────────────────────────
    # Must be before the /api/* block. Uses HTTP/1.1 for Upgrade header (Pitfall 1 prevention).
    # Caddy handles Upgrade and Connection headers automatically, but explicit http version
    # ensures compatibility with all upstream configurations.
    handle /ws* {
        reverse_proxy api:3000 {
            transport http {
                versions 1.1
            }
        }
    }

    # ── File API — explicit body size limit for uploads (D-18 revision) ──────
    # Must be before /api/* block. Enforces 25MB Caddy-layer limit (defense-in-depth).
    handle /api/files* {
        request_body {
            max_size 25MB
        }
        uri strip_prefix /api
        reverse_proxy api:3000
    }

    # ── API proxy ─────────────────────────────────────────────────────────────
    # Strip /api prefix before forwarding to backend (backend routes are at / not /api/)
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:3000
    }

    # ── Frontend SPA (React + Vite) ───────────────────────────────────────────
    handle {
        root * /srv/www
        try_files {path} /index.html
        file_server
    }

    # ── Logging ───────────────────────────────────────────────────────────────
    log {
        output stdout
        format console
    }
}

# ── Stage 1: Build ────────────────────────────────────────────────────────────
# Using node:22-slim (Debian glibc) instead of node:22-alpine (musl) so that
# sharp and argon2 can use prebuilt native binaries. On alpine/musl they fall
# back to build-from-source via node-gyp, which requires python3/make/g++ and
# significant build-time memory. slim is ~100 MB larger but strictly simpler.
FROM node:22-slim AS builder

WORKDIR /app

# tsconfig.base.json lives one level above server/tsconfig.json which extends
# "../tsconfig.base.json". We place it at /tsconfig.base.json so that the
# relative path resolves correctly when WORKDIR is /app.
COPY tsconfig.base.json /tsconfig.base.json
COPY server/package.json ./

# Install directly into /app (not via workspace flag). Skipping the root
# package-lock.json avoids npm workspace hoisting issues that failed on the
# build host. --legacy-peer-deps tolerates peer range conflicts in the server
# plugin stack (@fastify/*, drizzle, sharp).
RUN npm install --no-audit --no-fund --legacy-peer-deps

COPY server/ ./
RUN npm run build

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM node:22-slim AS runtime

WORKDIR /app

COPY server/package.json ./
RUN npm install --omit=dev --no-audit --no-fund --legacy-peer-deps

COPY --from=builder /app/dist ./dist
COPY server/drizzle ./drizzle

ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "dist/index.js"]

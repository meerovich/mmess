# ── Stage 1: Build ────────────────────────────────────────────────────────────
# Using node:22-slim (Debian glibc) instead of node:22-alpine (musl) so that
# sharp and argon2 can use prebuilt native binaries. On alpine/musl they fall
# back to build-from-source via node-gyp, which requires python3/make/g++ and
# significant build-time memory. slim is ~100 MB larger but strictly simpler.
FROM node:22-slim AS builder

WORKDIR /app

# tsconfig.base.json lives one level above server/tsconfig.json which extends
# "../tsconfig.base.json". We place it at /tsconfig.base.json so that the
# relative path resolves correctly when WORKDIR is /app.
COPY tsconfig.base.json /tsconfig.base.json

# Layer cache: package.json copied first; npm install only re-runs when deps change
COPY server/package.json ./

# Mount npm cache for faster rebuilds on VPS with limited RAM
RUN --mount=type=cache,target=/root/.npm \
    npm install --no-audit --no-fund --legacy-peer-deps

# Source changes don't invalidate npm install layer above
COPY server/ ./
RUN npm run build

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM node:22-slim AS runtime

WORKDIR /app

COPY server/package.json ./

# Reuse npm cache mount — production deps only
RUN --mount=type=cache,target=/root/.npm \
    npm install --omit=dev --no-audit --no-fund --legacy-peer-deps

COPY --from=builder /app/dist ./dist
COPY server/drizzle ./drizzle

ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "dist/index.js"]

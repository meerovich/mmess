# Copy to `.env.secrets` locally or `/opt/mmess/.env.production` on the VPS.
# Never commit the real file. Generate unique values per environment.

POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
JWT_ACCESS_SECRET=REPLACE_WITH_GENERATED_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_GENERATED_SECRET

# Optional push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional Codex Bot automation
CODEX_BOT_EMAIL=
CODEX_BOT_PASSWORD=
CODEX_BOT_USERNAME=Codex Bot
CODEX_TARGET_USERNAME=miha
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CODEX_BOT_SYSTEM_PROMPT=

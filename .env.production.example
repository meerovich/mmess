# ── Domain ────────────────────────────────────────────────────────────────────
# Set this to your VPS domain (e.g. chat.example.com)
# Caddy uses this for automatic TLS via Let's Encrypt
DOMAIN=mmess.example.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=mmess
POSTGRES_PASSWORD=change-me        # generate: openssl rand -hex 20
POSTGRES_DB=mmess

# Database URL used by the API (derived from above — keep in sync)
DATABASE_URL=postgresql://mmess:change-me@postgres:5432/mmess

# ── API ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# REQUIRED: generate secure secrets with:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_GENERATED_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_GENERATED_SECRET

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── File uploads ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50

# ── Codex Bot autoreply worker ───────────────────────────────────────────────
# Optional until you want autonomous chat replies from Codex Bot.
CODEX_BOT_EMAIL=codex@chatboris.local
CODEX_BOT_PASSWORD=ClaudeBot2026!
CODEX_BOT_USERNAME=Codex Bot
CODEX_TARGET_USERNAME=miha
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CODEX_BOT_SYSTEM_PROMPT=
